@page
@model CleaningCompanyWeb.Pages.LoginModel
@{
    ViewData["Title"] = "Sign In";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Renew Crew - Staff Sign In</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="login-wrapper">
        <div class="login-brand">
            <h1>Renew Crew</h1>
            <p>Workforce &amp; Payroll Management System</p>
            <div class="footer-note">
                Secretary &nbsp;•&nbsp; Worker &nbsp;•&nbsp; Manager &nbsp;•&nbsp; CEO<br />
                role-based access
            </div>
        </div>

        <div class="login-form-panel">
            <div class="login-card">
                <h2>Welcome back</h2>
                <p class="subheading">Sign in with the account provided by your manager or the CEO.</p>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="error-message">@Model.ErrorMessage</div>
                }

                <form method="post">
                    <label class="field-label" for="Username">Username</label>
                    <input class="text-input" type="text" id="Username" name="Username"
                           value="@Model.Username" autofocus autocomplete="username" />

                    <label class="field-label" for="Password">Password</label>
                    <input class="text-input" type="password" id="Password" name="Password"
                           autocomplete="current-password" />

                    <button type="submit" class="btn-primary">SIGN IN</button>
                </form>

                <div class="version-tag">v1.0 &nbsp;•&nbsp; Cleaning Company ERP (Web)</div>
            </div>
        </div>
    </div>
</body>
</html>
